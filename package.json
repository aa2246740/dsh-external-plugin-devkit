{
  "name": "dsh-external-plugin-devkit",
  "version": "0.3.0",
  "description": "Out-of-process DeepSeek Harness plugin devkit with an optional WebUI-first Creator Mode+ bridge.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-external-plugin-devkit.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-external-plugin-devkit",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-external-plugin-devkit/issues"
  },
  "bin": {
    "dshx": "./src/cli.ts"
  },
  "exports": {
    "./creator-plus": "./src/creator-plus/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dshx": "node --import tsx/esm src/cli.ts",
    "install:creator-plus": "node scripts/install-creator-plus.mjs",
    "test": "node --import tsx/esm --test tests/*.spec.ts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dshx",
    "plugin",
    "devkit"
  ],
  "files": [
    "src",
    "creator-plus",
    "scripts/install-creator-plus.mjs",
    "dshx.yml",
    "knowledge",
    "skill",
    "examples",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "js-yaml": "^4.2.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0"
  }
}
