{
  "name": "dsh-external-plugin-devkit",
  "version": "0.7.0",
  "description": "Out-of-process DeepSeek Harness plugin devkit with Creator Mode+ session claims and an external self-recovery Guardian.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-external-plugin-devkit.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-external-plugin-devkit",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-external-plugin-devkit/issues"
  },
  "bin": {
    "dshx": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/creator-plus/index.js",
    "./client-build": "./src/client-build.js",
    "./client": "./src/creator-plus/client.js",
    "./creator-plus": "./src/creator-plus/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "dshx": "node --import tsx/esm src/cli.ts",
    "install:creator-plus": "node scripts/install-creator-plus.mjs",
    "test": "node --import tsx/esm --test tests/*.spec.ts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dshx",
    "plugin",
    "devkit"
  ],
  "files": [
    "src",
    "creator-plus",
    "scripts/install-creator-plus.mjs",
    "dshx.yml",
    "knowledge",
    "skill",
    "examples",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "docs/screenshots"
  ],
  "dependencies": {
    "js-yaml": "^4.2.0",
    "lightningcss": "^1.32.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0"
  }
}
